{
  "name": "quiz-to-build---smart-city-adventure",
  "description": "Quiz to Build — Smart City Adventure: An interactive 3D educational city-building game where players solve quizzes to expand a thriving smart metropolis.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
